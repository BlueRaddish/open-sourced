# Keep this only on the server. Never prefix it with VITE_ or commit a real key.
OPENROUTER_API_KEY=your_openrouter_key_here
# Only openrouter/free or a model ending in :free is accepted by the server.
OPENROUTER_MODEL=openrouter/free
PORT=8787

# Optional for a separately deployed API, e.g. https://your-api.example.com/api/generate
# VITE_AI_ENDPOINT=
