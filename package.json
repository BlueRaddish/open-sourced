{
  "name": "studyforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n app,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:app": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "check": "npm run lint && npm run test && npm run build && npm run typecheck:server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/fraunces": "^5.2.6",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^1.34.0",
    "openai": "^5.20.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
